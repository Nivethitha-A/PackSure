# PACKSURE AI ENVIRONMENT CONFIGURATION

# Port where the Node.js Express server and React SPA run (Default: 3000)
PORT=3000

# Path to the custom-trained YOLO11 mechanical parts ONNX model (or .pt if Ultralytics export is available)
# Defaults to models/best.onnx
MODEL_PATH="models/best.onnx"

# AI Inspection default confidence and IoU thresholds
CONF_THRESHOLD=0.50
IOU_THRESHOLD=0.45

# GEMINI_API_KEY: Injected by AI Studio if external services are invoked
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
